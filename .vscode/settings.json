{
    "C_Cpp.default.compileCommands": "${workspaceFolder}/build/Release/compile_commands.json",
    "C_Cpp.default.cppStandard": "c++17",
    "C_Cpp.default.intelliSenseMode": "linux-gcc-x64",
    "C_Cpp.intelliSenseEngine": "default",
    "clangd.arguments": [
        "--compile-commands-dir=${workspaceFolder}/build/Release",
        "--query-driver=/usr/bin/c++,/usr/bin/g++,/usr/bin/gcc,/usr/bin/cc",
        "--header-insertion=never",
        "--background-index",
        "--pch-storage=memory"
    ],
    "clangd.onConfigChanged": "restart",
    "cursor.composer.textSizeScale": 1.3
}

